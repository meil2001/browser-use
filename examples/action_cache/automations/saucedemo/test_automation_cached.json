{
  "url": "https://www.saucedemo.com/",
  "parameters": {
    "input_parameters": {
      "username": [
        "standard_user"
      ],
      "password": [
        "secret_sauce"
      ]
    },
    "generated_parameters": {}
  },
  "nodes": [
    {
      "type": "action_node",
      "interaction_action": {
        "input_text": {
          "command": "locator(\"[name=\\\"user-name\\\"]\").first",
          "prompt_instructions": "Fill the field Username (name=user-name)",
          "input_text": "{username[0]}",
          "skip_prompt": true
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "input_text": {
          "command": "locator(\"[name=\\\"password\\\"]\").first",
          "prompt_instructions": "Fill the field Password (name=password)",
          "input_text": "{password[0]}",
          "skip_prompt": true
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "locator(\"[name=\\\"login-button\\\"]\").first",
          "prompt_instructions": "Click the element Login (name=login-button)",
          "skip_prompt": true
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "locator(\"[name=\\\"add-to-cart-sauce-labs-backpack\\\"]\").first",
          "prompt_instructions": "Click the element Add to cart (name=add-to-cart-sauce-labs-backpack)",
          "skip_prompt": true
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "locator(\"[data-test=\\\"shopping-cart-link\\\"]\").first",
          "prompt_instructions": "Click the element 1 (data-test=shopping-cart-link)",
          "skip_prompt": true
        }
      }
    }
  ]
}
